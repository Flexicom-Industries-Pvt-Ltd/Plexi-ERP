// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Module {
  SETTINGS
  USERS
  SECURITY_GATE
  INVENTORY
  PRODUCTION
  QUALITY_CONTROL
  DISPATCH
  DATA_CENTRE
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  module    Module
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

model User {
  id            String      @id @default(cuid())
  employeeId    String?     @unique
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  isActive      Boolean     @default(true)
  roleId        String?
  role          Role?       @relation(fields: [roleId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  files             FileAsset[]
  gateEntries       GateEntry[]    @relation("GateEntryCreator")
  verifiedDocuments GateDocument[] @relation("DocumentVerifier")
  inventoryTransactions InventoryTransaction[]
  createdAt         DateTime       @default(now())
  updatedAt     DateTime    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED_GOOD
  SCRAP
}

enum UomType {
  WEIGHT
  LENGTH
  QUANTITY
  VOLUME
}

model Shift {
  id        String   @id @default(cuid())
  name      String   @unique
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnitOfMeasurement {
  id           String   @id @default(cuid())
  name         String   @unique
  abbreviation String   @unique
  type         UomType
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inventoryItems InventoryItem[]
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?
  itemType      ItemType
  subCategories SubCategory[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  inventoryItems InventoryItem[]
}

model Driver {
  id            String      @id @default(cuid())
  name          String
  phone         String      @unique
  licenseNumber String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}


model SubCategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([categoryId, name])
}

model AuditLog {
  id            String   @id @default(cuid())
  correlationId String?
  userId        String?
  action        String
  module        Module
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  durationMs    Int?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([correlationId])
  @@index([module])
  @@index([action])
  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
}

model FileAsset {
  id         String   @id @default(cuid())
  fileName   String
  fileKey    String   @unique
  mimeType   String
  sizeBytes  Int
  module     Module
  uploadedBy String?
  url        String? // Presigned URL or public URL
  createdAt  DateTime @default(now())

  user User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([uploadedBy])
}

// ==========================================
// Phase 1: Factory & Organization Master Data
// ==========================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections Section[]
  users    User[]
}

model Section {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  code         String   @unique
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  machines   Machine[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

enum LocationType {
  GATE
  WAREHOUSE
  PRODUCTION_FLOOR
  SCRAP_YARD
  OFFICE
}

model Location {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  type        LocationType
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inventoryItems InventoryItem[]
}

model Machine {
  id           String   @id @default(cuid())
  sectionId    String
  name         String
  serialNumber String?  @unique
  make         String?
  model        String?
  status       String   @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([sectionId])
}

model ConfigParameter {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isSystem    Boolean  @default(false) // System configs cannot be deleted
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LogEntry {
  id               String    @id @default(uuid())
  timestamp        DateTime  @default(now())
  userId           String?
  correlationId    String    @unique
  module           String    // e.g., "AUTH", "SECURITY_GATE", "SETTINGS", "PROFILE"
  severity         String    // INFO, NOTICE, WARN, ERROR, CRITICAL, SECURITY
  action           String    // descriptive name of the event
  payload          Json      // original payload (redacted before save)
  redactedPayload  Json      // payload after redaction (stored for audit)
  ip               String?
  location         String?
  userAgent        String?
  durationMs       Int?
  meta             Json?     // any extra data (e.g., requestId, deviceId)
  diffs            LogDiff[] @relation("LogEntryDiffs")

  // Request-level fields (API/Request Logs per PRD §2)
  httpMethod       String?   // GET, POST, PATCH, DELETE
  url              String?   // The request URL/route
  statusCode       Int?      // HTTP response status code

  // Device/Client fields (per PRD §6)
  deviceType       String?   // desktop, mobile, tablet
  browser          String?   // Chrome 126, Firefox 128, etc.
  os               String?   // Windows 11, macOS 15, etc.

  // Performance indexes for search
  @@index([timestamp])
  @@index([module])
  @@index([severity])
  @@index([userId])
  @@index([statusCode])
  @@index([httpMethod])
}

model LogDiff {
  id          String   @id @default(uuid())
  logEntryId  String
  logEntry    LogEntry @relation("LogEntryDiffs", fields: [logEntryId], references: [id])
  entity      String   // e.g., "Department", "User"
  entityId    String
  before      Json
  after       Json
}

// ==========================================
// Phase 4: Security & Gate Management
// ==========================================

enum GateEntryStatus {
  ARRIVED
  DOCUMENT_VERIFICATION
  VERIFIED
  PARKING
  READY
  LOADING
  UNLOADING
  COMPLETED
  GATE_OUT
  ON_HOLD
  REJECTED
  CANCELLED
}

enum GatePurpose {
  LOADING
  UNLOADING
  OTHER
}

enum DocumentStatus {
  PENDING
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
}

model GateEntry {
  id               String          @id @default(cuid())
  entryNumber      String          @unique // E.g., GE-20231015-001
  truckNumber      String
  driverName       String
  driverContact    String?
  driverLicenseNumber String?
  transporter      String?
  supplierCustomer String?
  purpose          GatePurpose
  status           GateEntryStatus @default(ARRIVED)
  
  arrivalTime      DateTime        @default(now())
  exitTime         DateTime?
  
  expectedMaterial String?
  expectedQuantity Float?
  
  // Parking/Waiting
  parkingLocation  String?
  waitingReason    String?
  
  // Final Exit
  finalQuantity    Float?
  finalRemarks     String?
  
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  stockDetails     TruckStockDetail[]
  documents        GateDocument[]
  
  // Relation to user who created it
  user             User?           @relation("GateEntryCreator", fields: [createdBy], references: [id])

  @@index([status])
  @@index([truckNumber])
  @@index([arrivalTime])
}

model TruckStockDetail {
  id               String    @id @default(cuid())
  gateEntryId      String
  materialName     String
  materialType     String?
  quantity         Float
  unit             String
  batchLot         String?
  supplierCustomer String?
  expectedQuantity Float?
  actualQuantity   Float?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  gateEntry        GateEntry @relation(fields: [gateEntryId], references: [id], onDelete: Cascade)
}

model GateDocument {
  id             String         @id @default(cuid())
  gateEntryId    String
  documentType   String         // E.g., Invoice, Weighbridge Slip, PO
  fileUrl        String?        // URL or file reference
  status         DocumentStatus @default(PENDING)
  remarks        String?
  verifiedBy     String?        // User ID
  verifiedAt     DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  gateEntry      GateEntry      @relation(fields: [gateEntryId], references: [id], onDelete: Cascade)
  verifier       User?          @relation("DocumentVerifier", fields: [verifiedBy], references: [id])
}

// ==========================================
// Phase 3: Materials & Inventory Management
// ==========================================

model InventoryItem {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  itemType        ItemType
  categoryId      String?
  subCategoryId   String?
  uomId           String
  locationId      String?
  
  currentStock    Float    @default(0)
  minimumStock    Float    @default(0)
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        Category?    @relation(fields: [categoryId], references: [id])
  subCategory     SubCategory? @relation(fields: [subCategoryId], references: [id])
  uom             UnitOfMeasurement @relation(fields: [uomId], references: [id])
  location        Location?    @relation(fields: [locationId], references: [id])
  transactions    InventoryTransaction[]

  @@index([itemType])
  @@index([categoryId])
  @@index([locationId])
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  itemId          String
  type            TransactionType
  quantity        Float
  referenceType   String?  // e.g. "GATE_ENTRY", "MANUAL"
  referenceId     String?  // e.g. GateEntry.id
  remarks         String?
  
  userId          String?
  createdAt       DateTime @default(now())

  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])

  @@index([itemId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}
