// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Module {
  SETTINGS
  USERS
  SECURITY_GATE
  INVENTORY
  FINISHED_GOODS
  PRODUCTION
  TAPE_PLANT
  QUALITY_CONTROL
  RECYCLING_PLANT
  MAINTENANCE
  DISPATCH
  DATA_CENTRE
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  module    Module
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

model User {
  id            String      @id @default(cuid())
  employeeId    String?     @unique
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  isActive      Boolean     @default(true)
  roleId        String?
  role          Role?       @relation(fields: [roleId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  files             FileAsset[]
  gateEntries       GateEntry[]    @relation("GateEntryCreator")
  verifiedDocuments GateDocument[] @relation("DocumentVerifier")
  inventoryTransactions InventoryTransaction[]
  productionPlansCreated   ProductionPlan[]     @relation("ProductionPlanCreator")
  productionPlansApproved  ProductionPlan[]     @relation("ProductionPlanApprover")
  productionPlanLines        ProductionPlanLine[] @relation("ProductionPlanLineOperator")
  productionPlanLineAssignments ProductionPlanLineOperator[]
  productionRunsRecorded       ProductionRun[]              @relation("ProductionRunRecorder")
  shiftHandovers               ShiftHandover[]              @relation("ShiftHandoverAuthor")
  loomAssignments              LoomAssignment[]
  loomRunsOperated             LoomProductionRun[]          @relation("LoomRunOperator")
  laminationRunsOperated       LaminationProductionRun[]    @relation("LaminationRunOperator")
  printingRunsOperated         PrintingProductionRun[]      @relation("PrintingRunOperator")
  printingRunHelperAssignments PrintingProductionRunHelper[]
  cuttingRunsOperated          CuttingProductionRun[]       @relation("CuttingRunOperator")
  convertexRunsOperated        ConvertexProductionRun[]     @relation("ConvertexRunOperator")
  valvomaticRunsOperated       ValvomaticProductionRun[]    @relation("ValvomaticRunOperator")
  bcsRunsOperated              BcsProductionRun[]           @relation("BcsRunOperator")
  manualStitchRunsOperated     ManualStitchProductionRun[]  @relation("ManualStitchRunOperator")
  balesCreated                 Bale[]                       @relation("BaleCreator")
  qcInspections                QcInspection[]               @relation("QcInspector")
  reworkTicketsAssigned        QcReworkTicket[]             @relation("ReworkOperator")
  reworkTicketsCompleted       QcReworkTicket[]             @relation("ReworkCompleter")
  scrapRecordsRecorded         ScrapRecord[]                @relation("ScrapRecorder")
  recyclingBatchesOperated     RecyclingBatch[]             @relation("RecyclingOperator")
  maintenanceLogsReported      MaintenanceLog[]             @relation("MaintenanceReporter")
  maintenanceLogsAssigned      MaintenanceLog[]             @relation("MaintenanceTechnician")
  maintenanceLogsResolved      MaintenanceLog[]             @relation("MaintenanceResolver")
  finishedGoodsLotsReceived    FinishedGoodsLot[]           @relation("FinishedGoodsReceiver")
  dispatchOrdersCreated        DispatchOrder[]              @relation("DispatchOrderCreator")
  dispatchOrdersLoaded         DispatchOrder[]              @relation("DispatchOrderLoader")
  createdAt         DateTime       @default(now())
  updatedAt     DateTime    @updatedAt



  @@index([roleId, isActive])
  @@index([departmentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED_GOOD
  SCRAP
}

enum UomType {
  WEIGHT
  LENGTH
  QUANTITY
  VOLUME
}

model Shift {
  id        String   @id @default(cuid())
  name      String   @unique
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionPlans ProductionPlan[]
  handovers       ShiftHandover[]
  loomAssignments LoomAssignment[]
  bales           Bale[]
  tapePlantPlans              TapePlantPlan[]
  tapePlantTemperatures       TapePlantTemperatureReading[]
  tapePlantDriveParameters    TapePlantDriveParameter[]
  tapePlantRawMaterials       TapePlantRawMaterial[]
  tapePlantPostProductions    TapePlantPostProduction[]
}

enum StockMaterialType {
  RAW_MATERIALS
  BOBBINS
  PP_ROLLS
  LPP_ROLLS
  LAMINATED_ROLLS
  PRINTED_ROLLS
  CUT_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_BAGS
  BALES
  SCRAP
  RP_GRANULES
  EXTERNAL_MATERIALS
}

model UnitOfMeasurement {
  id           String   @id @default(cuid())
  name         String   @unique
  abbreviation String   @unique
  type         UomType
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inventoryItems InventoryItem[]
  stocks         Stock[]
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?
  itemType      ItemType
  subCategories SubCategory[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  inventoryItems InventoryItem[]
}

model Driver {
  id            String      @id @default(cuid())
  name          String
  phone         String      @unique
  licenseNumber String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Stock {
  id            String             @id @default(cuid())
  code          String             @unique
  name          String             @unique
  materialType  StockMaterialType
  uomId         String
  description   String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  uom           UnitOfMeasurement  @relation(fields: [uomId], references: [id])
  truckLines    TruckStockDetail[]
  inventoryItems InventoryItem[]

  @@index([materialType])
  @@index([uomId])
}


model SubCategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([categoryId, name])
}

model AuditLog {
  id            String   @id @default(cuid())
  correlationId String?
  userId        String?
  action        String
  module        Module
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  durationMs    Int?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([correlationId])
  @@index([module])
  @@index([action])
  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
}

model FileAsset {
  id         String   @id @default(cuid())
  fileName   String
  fileKey    String   @unique
  mimeType   String
  sizeBytes  Int
  module     Module
  uploadedBy String?
  url        String? // Presigned URL or public URL
  createdAt  DateTime @default(now())

  user User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([uploadedBy])
}

// ==========================================
// Phase 1: Factory & Organization Master Data
// ==========================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections Section[]
  users    User[]
}

model Section {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  code         String   @unique
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  machines   Machine[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

enum LocationType {
  GATE
  WAREHOUSE
  PRODUCTION_FLOOR
  SCRAP_YARD
  OFFICE
}

model Location {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  type        LocationType
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inventoryItems InventoryItem[]
  inventoryBatches InventoryBatch[]
  productionRolls  ProductionRoll[]
  scrapRecords     ScrapRecord[]    @relation("LocationScrapRecords")
  recyclingBatches RecyclingBatch[] @relation("RecyclingOutputLocation")
  finishedGoodsLots FinishedGoodsLot[] @relation("LocationFinishedGoodsLots")
}


model Machine {
  id           String   @id @default(cuid())
  sectionId    String
  name         String
  serialNumber String?  @unique
  make         String?
  model        String?
  status       String   @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  productionPlanLines ProductionPlanLine[]
  loomAssignmentMachines LoomAssignmentMachine[]
  loomRuns               LoomProductionRun[]     @relation("LoomRunMachine")
  laminationRuns         LaminationProductionRun[] @relation("LaminationRunMachine")
  printingRuns           PrintingProductionRun[]   @relation("PrintingRunMachine")
  cuttingRuns            CuttingProductionRun[]    @relation("CuttingRunMachine")
  convertexRuns          ConvertexProductionRun[]  @relation("ConvertexRunMachine")
  valvomaticRuns         ValvomaticProductionRun[] @relation("ValvomaticRunMachine")
  bcsRuns                BcsProductionRun[]        @relation("BcsRunMachine")
  maintenanceLogs        MaintenanceLog[]

  @@index([sectionId])
}

model ConfigParameter {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isSystem    Boolean  @default(false) // System configs cannot be deleted
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LogEntry {
  id               String    @id @default(uuid())
  timestamp        DateTime  @default(now())
  userId           String?
  correlationId    String    @unique
  module           String    // e.g., "AUTH", "SECURITY_GATE", "SETTINGS", "PROFILE"
  severity         String    // INFO, NOTICE, WARN, ERROR, CRITICAL, SECURITY
  action           String    // descriptive name of the event
  payload          Json      // original payload (redacted before save)
  redactedPayload  Json      // payload after redaction (stored for audit)
  ip               String?
  location         String?
  userAgent        String?
  durationMs       Int?
  meta             Json?     // any extra data (e.g., requestId, deviceId)
  diffs            LogDiff[] @relation("LogEntryDiffs")

  // Request-level fields (API/Request Logs per PRD §2)
  httpMethod       String?   // GET, POST, PATCH, DELETE
  url              String?   // The request URL/route
  statusCode       Int?      // HTTP response status code

  // Device/Client fields (per PRD §6)
  deviceType       String?   // desktop, mobile, tablet
  browser          String?   // Chrome 126, Firefox 128, etc.
  os               String?   // Windows 11, macOS 15, etc.

  // Performance indexes for search
  @@index([timestamp])
  @@index([module])
  @@index([severity])
  @@index([userId])
  @@index([statusCode])
  @@index([httpMethod])
}

model LogDiff {
  id          String   @id @default(uuid())
  logEntryId  String
  logEntry    LogEntry @relation("LogEntryDiffs", fields: [logEntryId], references: [id])
  entity      String   // e.g., "Department", "User"
  entityId    String
  before      Json
  after       Json
}

// ==========================================
// Phase 4: Security & Gate Management
// ==========================================

enum GateEntryStatus {
  ARRIVED
  DOCUMENT_VERIFICATION
  VERIFIED
  PARKING
  READY
  LOADING
  UNLOADING
  COMPLETED
  GATE_OUT
  ON_HOLD
  REJECTED
  CANCELLED
}

enum GatePurpose {
  LOADING
  UNLOADING
  OTHER
}

enum DocumentStatus {
  PENDING
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
}

model GateEntry {
  id               String          @id @default(cuid())
  entryNumber      String          @unique // E.g., GE-20231015-001
  truckNumber      String
  driverName       String
  driverContact    String?
  driverLicenseNumber String?
  transporter      String?
  supplierCustomer String?
  purpose          GatePurpose
  status           GateEntryStatus @default(ARRIVED)
  
  arrivalTime      DateTime        @default(now())
  exitTime         DateTime?
  
  expectedMaterial String?
  expectedQuantity Float?
  
  // Parking/Waiting
  parkingLocation  String?
  waitingReason    String?
  
  // Final Exit
  finalQuantity    Float?
  finalRemarks     String?
  
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  stockDetails     TruckStockDetail[]
  documents        GateDocument[]
  dispatchOrders   DispatchOrder[]
  
  // Relation to user who created it
  user             User?           @relation("GateEntryCreator", fields: [createdBy], references: [id])

  @@index([status])
  @@index([truckNumber])
  @@index([arrivalTime])
  @@index([status, arrivalTime])
}

model TruckStockDetail {
  id               String    @id @default(cuid())
  gateEntryId      String
  stockId          String?
  materialName     String
  materialType     String?
  quantity         Float
  unit             String
  batchLot         String?
  supplierCustomer String?
  expectedQuantity Float?
  actualQuantity   Float?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  gateEntry        GateEntry @relation(fields: [gateEntryId], references: [id], onDelete: Cascade)
  stock            Stock?    @relation(fields: [stockId], references: [id], onDelete: SetNull)

  @@index([stockId])
  @@index([gateEntryId])
}

model GateDocument {
  id             String         @id @default(cuid())
  gateEntryId    String
  documentType   String         // E.g., Invoice, Weighbridge Slip, PO
  fileUrl        String?        // URL or file reference
  status         DocumentStatus @default(PENDING)
  remarks        String?
  verifiedBy     String?        // User ID
  verifiedAt     DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  gateEntry      GateEntry      @relation(fields: [gateEntryId], references: [id], onDelete: Cascade)
  verifier       User?          @relation("DocumentVerifier", fields: [verifiedBy], references: [id])

  @@index([gateEntryId, status])
}

// ==========================================
// Phase 3: Materials & Inventory Management
// ==========================================

model InventoryItem {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  itemType        ItemType
  categoryId      String?
  subCategoryId   String?
  uomId           String
  locationId      String?
  stockId         String?  @unique
  
  currentStock    Float    @default(0)
  reservedStock   Float    @default(0)
  minimumStock    Float    @default(0)
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        Category?    @relation(fields: [categoryId], references: [id])
  subCategory     SubCategory? @relation(fields: [subCategoryId], references: [id])
  uom             UnitOfMeasurement @relation(fields: [uomId], references: [id])
  location        Location?    @relation(fields: [locationId], references: [id])
  stock           Stock?       @relation(fields: [stockId], references: [id], onDelete: SetNull)
  transactions    InventoryTransaction[]
  batches         InventoryBatch[]
  productionPlanLines ProductionPlanLine[]
  bobbinRunsAsRawMaterial BobbinProductionRun[] @relation("BobbinRunRawMaterial")
  bobbinRunsAsOutput      BobbinProductionRun[] @relation("BobbinRunOutput")
  loomRunsAsBobbin        LoomProductionRun[]   @relation("LoomRunBobbin")
  loomRunsAsRoll          LoomProductionRun[]   @relation("LoomRunRoll")
  productionRolls         ProductionRoll[]
  cuttingRunsAsOutput     CuttingProductionRun[] @relation("CuttingRunOutput")
  convertexRunsAsInput    ConvertexProductionRun[] @relation("ConvertexRunInput")
  convertexRunsAsOutput   ConvertexProductionRun[] @relation("ConvertexRunOutput")
  valvomaticRunsAsOutput  ValvomaticProductionRun[] @relation("ValvomaticRunOutput")
  bcsRunsAsOutput         BcsProductionRun[]      @relation("BcsRunOutput")
  manualStitchRunsAsInput ManualStitchProductionRun[] @relation("ManualStitchRunInput")
  manualStitchRunsAsOutput ManualStitchProductionRun[] @relation("ManualStitchRunOutput")
  balesAsProduct          Bale[] @relation("BaleProduct")
  balesAsOutput           Bale[] @relation("BaleOutputItem")
  scrapRecords            ScrapRecord[] @relation("ItemScrapRecords")
  recyclingBatchesAsOutput RecyclingBatch[] @relation("RecyclingOutputItem")
  finishedGoodsLots       FinishedGoodsLot[] @relation("ItemFinishedGoodsLots")
  dispatchOrderLines      DispatchOrderLine[] @relation("ItemDispatchLines")

  @@index([itemType])
  @@index([categoryId])
  @@index([locationId])
  @@index([stockId])
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  itemId          String
  type            TransactionType
  quantity        Float
  batchLot        String?
  referenceType   String?  // e.g. "GATE_ENTRY", "MANUAL", "SCRAP"
  referenceId     String?  // e.g. GateEntry.id, ScrapRecord.id
  remarks         String?
  
  userId          String?
  createdAt       DateTime @default(now())

  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])
  scrapRecords    ScrapRecord[] @relation("ScrapInventoryTransaction")
  recyclingBatches RecyclingBatch[] @relation("RecyclingInventoryTransaction")
  finishedGoodsLots FinishedGoodsLot[] @relation("FinishedGoodsInventoryTransaction")

  @@index([itemId])
  @@index([type])
  @@index([referenceType])
  @@index([referenceId])

  @@index([batchLot])
  @@index([createdAt])
}

model InventoryBatch {
  id          String   @id @default(cuid())
  itemId      String
  batchLot    String
  quantity    Float    @default(0)
  locationId  String?
  gateEntryId String?
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([itemId, batchLot])
  @@index([itemId])
  @@index([batchLot])
  @@index([locationId])
}

enum ProductionPhase {
  BOBBIN
  LOOM
  LAMINATION
  PRINTING
  CUTTING
  CONVERTEX
  VALVOMATIC
  BCS
  MANUAL_STITCH
  BALING
}

enum FinishingRoute {
  CONVERTEX
  VALVOMATIC
  BCS
  MANUAL_STITCH
}

enum ProductionPlanStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionCharacteristicFieldType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
  DATE
}

model ProductionPlan {
  id           String               @id @default(cuid())
  planNumber   String               @unique
  shiftId      String?
  planDate     DateTime             @default(now())
  status       ProductionPlanStatus @default(DRAFT)
  notes        String?
  createdById  String
  approvedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  shift      Shift?               @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy  User                 @relation("ProductionPlanCreator", fields: [createdById], references: [id])
  approvedBy User?                @relation("ProductionPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines      ProductionPlanLine[]

  @@index([status])
  @@index([planDate])
  @@index([shiftId])
  @@index([planDate, status])
}

model ProductionPlanLine {
  id              String          @id @default(cuid())
  planId          String
  phase           ProductionPhase
  finishingRoute  FinishingRoute?
  machineId       String?
  operatorId      String?
  inventoryItemId String?
  targetQty       Float           @default(0)
  priority        Int             @default(0)
  instructions    String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  plan            ProductionPlan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  machine         Machine?                        @relation(fields: [machineId], references: [id], onDelete: SetNull)
  operator        User?                           @relation("ProductionPlanLineOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem?                  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  operators       ProductionPlanLineOperator[]
  characteristics ProductionCharacteristicValue[]
  runs            ProductionRun[]

  @@index([planId])
  @@index([phase])
  @@index([finishingRoute])
  @@index([machineId])
  @@index([inventoryItemId])
}

model ProductionPlanLineOperator {
  id         String   @id @default(cuid())
  planLineId String
  userId     String
  createdAt  DateTime @default(now())

  planLine ProductionPlanLine @relation(fields: [planLineId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planLineId, userId])
  @@index([planLineId])
  @@index([userId])
}

model ProductionCharacteristicDefinition {
  id        String                            @id @default(cuid())
  phase     ProductionPhase
  key       String
  label     String
  fieldType ProductionCharacteristicFieldType
  options   Json?
  required  Boolean                           @default(false)
  sortOrder Int                               @default(0)
  isActive  Boolean                           @default(true)
  createdAt DateTime                          @default(now())
  updatedAt DateTime                          @updatedAt

  values ProductionCharacteristicValue[]

  @@unique([phase, key])
  @@index([phase])
}

model ProductionCharacteristicValue {
  id           String @id @default(cuid())
  planLineId   String
  definitionId String
  value        String

  planLine   ProductionPlanLine                 @relation(fields: [planLineId], references: [id], onDelete: Cascade)
  definition ProductionCharacteristicDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([planLineId, definitionId])
  @@index([planLineId])
}

model ProductionRun {
  id              String    @id @default(cuid())
  planLineId      String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  targetQty       Float
  actualQty       Float     @default(0)
  acceptedQty     Float     @default(0)
  rejectedQty     Float     @default(0)
  reworkQty       Float     @default(0)
  scrapQty        Float     @default(0)
  downtimeMinutes Int       @default(0)
  recordedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  planLine   ProductionPlanLine @relation(fields: [planLineId], references: [id], onDelete: Cascade)
  recordedBy User?              @relation("ProductionRunRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  bobbinRun  BobbinProductionRun?
  loomRun    LoomProductionRun?
  laminationRun LaminationProductionRun?
  printingRun   PrintingProductionRun?
  cuttingRun    CuttingProductionRun?
  convertexRun  ConvertexProductionRun?
  valvomaticRun ValvomaticProductionRun?
  bcsRun        BcsProductionRun?
  manualStitchRun ManualStitchProductionRun?
  productionRolls ProductionRoll[]

  @@index([planLineId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([planLineId, startedAt])
}

model BobbinProductionRun {
  id                    String   @id @default(cuid())
  productionRunId       String   @unique
  rawMaterialItemId     String
  outputItemId          String?
  inputQty              Float    @default(0)
  outputQty             Float    @default(0)
  bobbinCharacteristics Json?
  inventoryPosted       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  productionRun     ProductionRun  @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  rawMaterialItem   InventoryItem  @relation("BobbinRunRawMaterial", fields: [rawMaterialItemId], references: [id], onDelete: Restrict)
  outputItem        InventoryItem? @relation("BobbinRunOutput", fields: [outputItemId], references: [id], onDelete: SetNull)

  @@index([productionRunId])
  @@index([rawMaterialItemId])
  @@index([outputItemId])
}

enum RollType {
  PP
  LPP
}

model LoomAssignment {
  id             String   @id @default(cuid())
  shiftId        String
  operatorId     String
  assignmentDate DateTime @default(now())
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shift     Shift                   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  operator  User                    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  machines  LoomAssignmentMachine[]

  @@index([shiftId])
  @@index([operatorId])
  @@index([assignmentDate])
}

model LoomAssignmentMachine {
  id           String @id @default(cuid())
  assignmentId String
  machineId    String

  assignment LoomAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  machine    Machine        @relation(fields: [machineId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, machineId])
  @@unique([machineId, assignmentId])
  @@index([assignmentId])
  @@index([machineId])
}

model LoomProductionRun {
  id              String    @id @default(cuid())
  productionRunId String    @unique
  loomMachineId   String
  operatorId      String
  bobbinItemId    String?
  bobbinIssueQty  Float     @default(0)
  rollOutputQty   Float     @default(0)
  rollType        RollType?
  rollItemId      String?
  characteristics Json?
  inventoryPosted Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  productionRun ProductionRun  @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  loomMachine   Machine        @relation("LoomRunMachine", fields: [loomMachineId], references: [id], onDelete: Restrict)
  operator      User           @relation("LoomRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  bobbinItem    InventoryItem? @relation("LoomRunBobbin", fields: [bobbinItemId], references: [id], onDelete: SetNull)
  rollItem      InventoryItem? @relation("LoomRunRoll", fields: [rollItemId], references: [id], onDelete: SetNull)
  productionRoll ProductionRoll?

  @@index([productionRunId])
  @@index([loomMachineId])
  @@index([operatorId])
  @@index([bobbinItemId])
  @@index([rollItemId])
}

model LaminationProductionRun {
  id                  String   @id @default(cuid())
  productionRunId     String   @unique
  laminationMachineId String
  operatorId          String
  inputRollId         String
  inputQty            Float    @default(0)
  outputQty           Float    @default(0)
  characteristics     Json?
  inventoryPosted     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  productionRun     ProductionRun   @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  laminationMachine Machine         @relation("LaminationRunMachine", fields: [laminationMachineId], references: [id], onDelete: Restrict)
  operator          User            @relation("LaminationRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  inputRoll         ProductionRoll  @relation("LaminationInputRoll", fields: [inputRollId], references: [id], onDelete: Restrict)
  productionRoll    ProductionRoll?

  @@index([productionRunId])
  @@index([laminationMachineId])
  @@index([operatorId])
  @@index([inputRollId])
}

model PrintingProductionRun {
  id                String   @id @default(cuid())
  productionRunId   String   @unique
  printingMachineId String
  operatorId        String
  inputRollId       String
  brand             String?
  colour            String?
  artworkRef        String?
  inkMaterials      Json?
  inputQty          Float    @default(0)
  outputQty         Float    @default(0)
  characteristics   Json?
  inventoryPosted   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionRun   ProductionRun                 @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  printingMachine Machine                       @relation("PrintingRunMachine", fields: [printingMachineId], references: [id], onDelete: Restrict)
  operator        User                          @relation("PrintingRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  inputRoll       ProductionRoll                @relation("PrintingInputRoll", fields: [inputRollId], references: [id], onDelete: Restrict)
  productionRoll  ProductionRoll?
  helpers         PrintingProductionRunHelper[]

  @@index([productionRunId])
  @@index([printingMachineId])
  @@index([operatorId])
  @@index([inputRollId])
}

model PrintingProductionRunHelper {
  id            String   @id @default(cuid())
  printingRunId String
  userId        String
  createdAt     DateTime @default(now())

  printingRun PrintingProductionRun @relation(fields: [printingRunId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([printingRunId, userId])
  @@index([printingRunId])
  @@index([userId])
}

model CuttingProductionRun {
  id                String   @id @default(cuid())
  productionRunId   String   @unique
  cuttingMachineId  String
  operatorId        String
  inputRollId       String
  cuttingSpec       String?
  inputQty          Float    @default(0)
  outputMaterialQty Float    @default(0)
  outputItemId      String?
  characteristics   Json?
  inventoryPosted   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionRun  ProductionRun  @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  cuttingMachine Machine        @relation("CuttingRunMachine", fields: [cuttingMachineId], references: [id], onDelete: Restrict)
  operator       User           @relation("CuttingRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  inputRoll      ProductionRoll @relation("CuttingInputRoll", fields: [inputRollId], references: [id], onDelete: Restrict)
  outputItem     InventoryItem? @relation("CuttingRunOutput", fields: [outputItemId], references: [id], onDelete: SetNull)

  @@index([productionRunId])
  @@index([cuttingMachineId])
  @@index([operatorId])
  @@index([inputRollId])
  @@index([outputItemId])
}

model ConvertexProductionRun {
  id                 String   @id @default(cuid())
  productionRunId    String   @unique
  convertexMachineId String
  operatorId         String
  inputMaterialId    String
  inputQty           Float    @default(0)
  outputBagQty       Float    @default(0)
  outputItemId       String?
  characteristics    Json?
  inventoryPosted    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  productionRun    ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  convertexMachine Machine       @relation("ConvertexRunMachine", fields: [convertexMachineId], references: [id], onDelete: Restrict)
  operator         User          @relation("ConvertexRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  inputMaterial    InventoryItem @relation("ConvertexRunInput", fields: [inputMaterialId], references: [id], onDelete: Restrict)
  outputItem       InventoryItem? @relation("ConvertexRunOutput", fields: [outputItemId], references: [id], onDelete: SetNull)

  @@index([productionRunId])
  @@index([convertexMachineId])
  @@index([operatorId])
  @@index([inputMaterialId])
  @@index([outputItemId])
}

model ValvomaticProductionRun {
  id                  String   @id @default(cuid())
  productionRunId     String   @unique
  valvomaticMachineId String
  operatorId          String
  inputs              Json
  outputBagQty        Float    @default(0)
  outputItemId        String?
  characteristics     Json?
  inventoryPosted     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  productionRun     ProductionRun  @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  valvomaticMachine Machine        @relation("ValvomaticRunMachine", fields: [valvomaticMachineId], references: [id], onDelete: Restrict)
  operator          User           @relation("ValvomaticRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  outputItem        InventoryItem? @relation("ValvomaticRunOutput", fields: [outputItemId], references: [id], onDelete: SetNull)

  @@index([productionRunId])
  @@index([valvomaticMachineId])
  @@index([operatorId])
  @@index([outputItemId])
}

model BcsProductionRun {
  id                String   @id @default(cuid())
  productionRunId   String   @unique
  bcsMachineId      String
  operatorId        String
  teamMemberIds     Json     @default("[]")
  inputs            Json
  outputBagQty      Float    @default(0)
  outputItemId      String?
  characteristics   Json?
  bcsRulesSnapshot  Json?
  inventoryPosted   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionRun ProductionRun  @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  bcsMachine    Machine        @relation("BcsRunMachine", fields: [bcsMachineId], references: [id], onDelete: Restrict)
  operator      User           @relation("BcsRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  outputItem    InventoryItem? @relation("BcsRunOutput", fields: [outputItemId], references: [id], onDelete: SetNull)

  @@index([productionRunId])
  @@index([bcsMachineId])
  @@index([operatorId])
  @@index([outputItemId])
}

model ManualStitchProductionRun {
  id              String   @id @default(cuid())
  productionRunId String   @unique
  operatorId      String
  workerIds       Json     @default("[]")
  inputMaterialId String
  inputQty        Float    @default(0)
  outputBagQty    Float    @default(0)
  outputItemId    String?
  characteristics Json?
  inventoryPosted Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionRun ProductionRun  @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  operator      User           @relation("ManualStitchRunOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  inputMaterial InventoryItem  @relation("ManualStitchRunInput", fields: [inputMaterialId], references: [id], onDelete: Restrict)
  outputItem    InventoryItem? @relation("ManualStitchRunOutput", fields: [outputItemId], references: [id], onDelete: SetNull)

  @@index([productionRunId])
  @@index([operatorId])
  @@index([inputMaterialId])
  @@index([outputItemId])
}

model Bale {
  id              String            @id @default(cuid())
  baleNumber      String            @unique
  productId       String
  baleItemId      String?
  bagsPerBale     Float
  quantity        Float
  productionBatch String?
  qualityStatus   RollQualityStatus @default(PENDING_QC)
  shiftId         String
  characteristics Json?
  inventoryPosted Boolean           @default(false)
  baledAt         DateTime          @default(now())
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  product   InventoryItem  @relation("BaleProduct", fields: [productId], references: [id], onDelete: Restrict)
  baleItem  InventoryItem? @relation("BaleOutputItem", fields: [baleItemId], references: [id], onDelete: SetNull)
  shift     Shift          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("BaleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  finishedGoodsLots FinishedGoodsLot[] @relation("BaleFinishedGoodsLots")

  @@index([productId])
  @@index([baleItemId])
  @@index([shiftId])
  @@index([qualityStatus])
  @@index([baledAt])
}

enum RollQualityStatus {
  PENDING_QC
  PASSED
  FAILED
  REWORK
  ON_HOLD
}

enum ProductionRollSourcePhase {
  LOOM
  LAMINATION
  PRINTING
}

model ProductionRoll {
  id                  String                    @id @default(cuid())
  rollNumber          String                    @unique
  rollType            RollType
  characteristics     Json?
  weight              Float?
  length              Float?
  batchLot            String?
  locationId          String?
  qualityStatus       RollQualityStatus         @default(PENDING_QC)
  inventoryItemId     String?
  sourcePhase         ProductionRollSourcePhase @default(LOOM)
  loomProductionRunId       String?                   @unique
  laminationProductionRunId String?                   @unique
  printingProductionRunId   String?                   @unique
  productionRunId           String?
  consumedAt                  DateTime?
  remarks                     String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  location                Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  inventoryItem           InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  loomProductionRun       LoomProductionRun?       @relation(fields: [loomProductionRunId], references: [id], onDelete: SetNull)
  laminationProductionRun LaminationProductionRun? @relation(fields: [laminationProductionRunId], references: [id], onDelete: SetNull)
  printingProductionRun   PrintingProductionRun?   @relation(fields: [printingProductionRunId], references: [id], onDelete: SetNull)
  productionRun           ProductionRun?           @relation(fields: [productionRunId], references: [id], onDelete: SetNull)
  laminationRunsAsInput   LaminationProductionRun[] @relation("LaminationInputRoll")
  printingRunsAsInput     PrintingProductionRun[]   @relation("PrintingInputRoll")
  cuttingRunsAsInput      CuttingProductionRun[]    @relation("CuttingInputRoll")

  @@index([rollType])
  @@index([qualityStatus])
  @@index([locationId])
  @@index([inventoryItemId])
  @@index([productionRunId])
  @@index([createdAt])
}

model ShiftHandover {
  id             String   @id @default(cuid())
  shiftId        String
  handoverDate   DateTime @default(now())
  completedQty   Float    @default(0)
  pendingQty     Float    @default(0)
  wipNotes       String?
  machineStatus  String?
  qualityIssues  String?
  scrapNotes     String?
  remarks        String?
  handedOverById String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shift        Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  handedOverBy User  @relation("ShiftHandoverAuthor", fields: [handedOverById], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@index([handoverDate])
}

// ─── Quality Control (Phase 5) ────────────────────────────────────────────────

enum QcReferenceType {
  ROLL
  BALE
  PRODUCTION_RUN
  BATCH
}

enum QcDecision {
  PASSED
  FAILED
  REWORK
  ON_HOLD
}

enum QcInspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model QcInspection {
  id                 String             @id @default(cuid())
  inspectionNumber   String             @unique
  referenceType      QcReferenceType
  referenceId        String
  status             QcInspectionStatus @default(PENDING)
  decision           QcDecision?
  inspectorId        String?
  notes              String?
  defectReason       String?
  reworkInstructions String?
  samplesInspected   Int                @default(1)
  parameters         Json?
  inspectedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  inspector          User?              @relation("QcInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  lines              QcInspectionLine[]
  reworkTickets      QcReworkTicket[]

  @@index([referenceType, referenceId])
  @@index([status])
  @@index([decision])
  @@index([inspectorId])
  @@index([createdAt])
}

model QcInspectionLine {
  id             String       @id @default(cuid())
  inspectionId   String
  parameterName  String
  standardValue  String?
  actualValue    String
  unit           String?
  status         QcDecision   @default(PASSED)
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inspection     QcInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([status])
}

enum QcReworkStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model QcReworkTicket {
  id                  String          @id @default(cuid())
  ticketNumber        String          @unique
  inspectionId        String?
  sourceReferenceType QcReferenceType
  sourceReferenceId   String
  targetPhase         String
  status              QcReworkStatus  @default(OPEN)
  defectReason        String?
  reworkInstructions  String?
  assignedOperatorId  String?
  completedById       String?
  reworkQty           Float?
  reworkCost          Float?
  notes               String?
  reworkCompletedAt   DateTime?
  reInspectionId      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  inspection       QcInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  assignedOperator User?         @relation("ReworkOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)
  completedBy      User?         @relation("ReworkCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@index([sourceReferenceType, sourceReferenceId])
  @@index([status])
  @@index([targetPhase])
  @@index([assignedOperatorId])
  @@index([createdAt])
}

enum ScrapSourceType {
  QC_INSPECTION
  PRODUCTION_RUN
  ROLL
  BALE
  MANUAL
}

model ScrapRecord {
  id                     String          @id @default(cuid())
  scrapNumber            String          @unique
  sourceType             ScrapSourceType @default(QC_INSPECTION)
  sourceId               String?
  phase                  String
  reasonCode             String
  quantity               Float
  unit                   String          @default("kg")
  inventoryItemId        String?
  locationId             String?
  inventoryTransactionId String?
  recyclingBatchId       String?
  isRecycled             Boolean         @default(false)
  recordedById           String?
  notes                  String?
  recordedAt             DateTime        @default(now())
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  inventoryItem        InventoryItem?        @relation("ItemScrapRecords", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  location             Location?             @relation("LocationScrapRecords", fields: [locationId], references: [id], onDelete: SetNull)
  recordedBy           User?                 @relation("ScrapRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  inventoryTransaction InventoryTransaction? @relation("ScrapInventoryTransaction", fields: [inventoryTransactionId], references: [id], onDelete: SetNull)
  recyclingBatch       RecyclingBatch?       @relation("BatchScrapRecords", fields: [recyclingBatchId], references: [id], onDelete: SetNull)

  @@index([sourceType, sourceId])
  @@index([phase])
  @@index([reasonCode])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([recordedById])
  @@index([recordedAt])
  @@index([recyclingBatchId])
  @@index([isRecycled])
}

enum RecyclingStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RecyclingBatch {
  id                     String          @id @default(cuid())
  batchNumber            String          @unique
  inputScrapQty          Float           @default(0)
  outputRpQty            Float?
  wasteLossQty           Float?
  granuleGrade           String?         // e.g. "RP-PP-GRADE-A", "RP-HDPE", "STANDARD"
  status                 RecyclingStatus @default(IN_PROGRESS)
  outputItemId           String?
  outputLocationId       String?
  operatorId             String?
  inventoryTransactionId String?
  notes                  String?
  startedAt              DateTime        @default(now())
  completedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  outputItem           InventoryItem?        @relation("RecyclingOutputItem", fields: [outputItemId], references: [id], onDelete: SetNull)
  outputLocation       Location?             @relation("RecyclingOutputLocation", fields: [outputLocationId], references: [id], onDelete: SetNull)
  operator             User?                 @relation("RecyclingOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  inventoryTransaction InventoryTransaction? @relation("RecyclingInventoryTransaction", fields: [inventoryTransactionId], references: [id], onDelete: SetNull)
  scrapRecords         ScrapRecord[]         @relation("BatchScrapRecords")

  @@index([status])
  @@index([outputItemId])
  @@index([outputLocationId])
  @@index([operatorId])
  @@index([startedAt])
  @@index([completedAt])
}

enum MaintenanceType {
  BREAKDOWN
  PREVENTATIVE
  ROUTINE_SERVICE
  INSPECTION
  CALIBRATION
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MaintenanceLog {
  id                   String              @id @default(cuid())
  logNumber            String              @unique
  machineId            String
  type                 MaintenanceType     @default(BREAKDOWN)
  priority             MaintenancePriority @default(MEDIUM)
  status               MaintenanceStatus   @default(OPEN)
  title                String
  description          String
  downtimeMinutes      Int                 @default(0)
  cost                 Float?
  reportedById         String?
  assignedTechnicianId String?
  resolvedById         String?
  reportedAt           DateTime            @default(now())
  startedAt            DateTime?
  resolvedAt           DateTime?
  correctiveAction     String?
  partsReplaced        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  machine            Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  reportedBy         User?   @relation("MaintenanceReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTechnician User?   @relation("MaintenanceTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  resolvedBy         User?   @relation("MaintenanceResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([machineId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([reportedById])
  @@index([assignedTechnicianId])
  @@index([reportedAt])
  @@index([resolvedAt])
}

// ─── Phase 6: Finished Goods & Commercial Dispatch ─────────────────────────────

enum FinishedGoodsStatus {
  AVAILABLE
  RESERVED
  ALLOCATED
  DISPATCHED
  ON_HOLD
  SCRAPPED
}

model FinishedGoodsLot {
  id                     String              @id @default(cuid())
  lotNumber              String              @unique
  inventoryItemId        String
  baleId                 String?
  quantity               Float               @default(0)
  initialQuantity        Float               @default(0)
  allocatedQty           Float               @default(0)
  dispatchedQty          Float               @default(0)
  unit                   String              @default("bags")
  productionBatch        String?
  grossWeight            Float?
  netWeight              Float?
  qualityStatus          RollQualityStatus   @default(PASSED)
  status                 FinishedGoodsStatus @default(AVAILABLE)
  locationId             String?
  inventoryTransactionId String?
  notes                  String?
  receivedById           String?
  receivedAt             DateTime            @default(now())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  inventoryItem        InventoryItem         @relation("ItemFinishedGoodsLots", fields: [inventoryItemId], references: [id], onDelete: Restrict)
  bale                 Bale?                 @relation("BaleFinishedGoodsLots", fields: [baleId], references: [id], onDelete: SetNull)
  location             Location?             @relation("LocationFinishedGoodsLots", fields: [locationId], references: [id], onDelete: SetNull)
  receivedBy           User?                 @relation("FinishedGoodsReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  inventoryTransaction InventoryTransaction? @relation("FinishedGoodsInventoryTransaction", fields: [inventoryTransactionId], references: [id], onDelete: SetNull)
  dispatchAllocations  DispatchAllocation[]  @relation("FinishedGoodsAllocations")

  @@index([inventoryItemId])
  @@index([baleId])
  @@index([locationId])
  @@index([status])
  @@index([qualityStatus])
  @@index([productionBatch])
  @@index([receivedAt])
}

enum DispatchOrderStatus {
  DRAFT
  CONFIRMED
  PICKING
  LOADED
  DISPATCHED
  CANCELLED
}

enum DispatchAllocationStatus {
  ALLOCATED
  LOADED
  CANCELLED
}

model DispatchOrder {
  id              String              @id @default(cuid())
  orderNumber     String              @unique
  customerName    String
  customerContact String?
  customerAddress String?
  status          DispatchOrderStatus @default(DRAFT)
  gateEntryId     String?
  transporter     String?
  vehicleNumber   String?
  driverName      String?
  driverPhone     String?
  totalQty        Float               @default(0)
  dispatchedQty   Float               @default(0)
  dispatchedAt    DateTime?
  notes           String?
  createdById     String?
  loadedById      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy User?               @relation("DispatchOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  loadedBy  User?               @relation("DispatchOrderLoader", fields: [loadedById], references: [id], onDelete: SetNull)
  gateEntry GateEntry?          @relation(fields: [gateEntryId], references: [id], onDelete: SetNull)
  lines     DispatchOrderLine[]

  @@index([status])
  @@index([customerName])
  @@index([gateEntryId])
  @@index([createdById])
  @@index([dispatchedAt])
  @@index([createdAt])
}

model DispatchOrderLine {
  id              String   @id @default(cuid())
  dispatchOrderId String
  inventoryItemId String
  orderedQty      Float
  pickedQty       Float    @default(0)
  loadedQty       Float    @default(0)
  unit            String   @default("bags")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dispatchOrder DispatchOrder        @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem        @relation("ItemDispatchLines", fields: [inventoryItemId], references: [id], onDelete: Restrict)
  allocations   DispatchAllocation[]

  @@index([dispatchOrderId])
  @@index([inventoryItemId])
}

model DispatchAllocation {
  id                  String                   @id @default(cuid())
  dispatchOrderLineId String
  finishedGoodsLotId  String
  allocatedQty        Float
  loadedQty           Float                    @default(0)
  status              DispatchAllocationStatus @default(ALLOCATED)
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  dispatchOrderLine DispatchOrderLine @relation(fields: [dispatchOrderLineId], references: [id], onDelete: Cascade)
  finishedGoodsLot  FinishedGoodsLot  @relation("FinishedGoodsAllocations", fields: [finishedGoodsLotId], references: [id], onDelete: Restrict)

  @@index([dispatchOrderLineId])
  @@index([finishedGoodsLotId])
  @@index([status])
}

// ==========================================
// Tape Plant (Kathua Plant v1.1)
// ==========================================

model TapePlantPlan {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD
  shiftId         String
  recipeQuality   String   // Internal codes e.g. "S1", "HC" preserved as plant uses them
  tapeType        String?  // "PP" | "LPP"
  denier          Float?
  tapeWidth       Float?
  strength        Float?
  eloPercent      Float?
  bobbinMarking   String?
  colour          String?
  spacerSize      String?
  requiredAsh     Float?
  ashPercent      Float?
  plannedQtyKg    Float    @default(0)
  omega           String?
  vistPercent     Float?
  remarks         String?
  materials       Json     @default("[]") // Array of { material, quantity, percentage }
  status          String   @default("DRAFT") // DRAFT | SUBMITTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([date, shiftId])
  @@index([date])
  @@index([shiftId])
}

model TapePlantTemperatureReading {
  id             String   @id @default(cuid())
  date           String   // YYYY-MM-DD
  shiftId        String
  time           String   // e.g. "12:00", "14:00"
  b1             Float?
  b2             Float?
  b3             Float?
  b4             Float?
  b5             Float?
  b6             Float?
  b7             Float?
  screenChanger  Float?
  ad1            Float?
  ad2            Float?
  meltPump       Float?
  d1             Float?
  d2             Float?
  d3             Float?
  d4             Float?
  d5             Float?
  d6             Float?
  d7             Float?
  meltTemp       Float?
  h1             Float?
  h2             Float?
  housingWater   Float?
  hotAirTemp     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([date, shiftId])
}

model TapePlantDriveParameter {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD
  shiftId         String
  time            String   // e.g. "12:00", "14:00"
  extruderRpm     Float?
  meltPumpRpm     Float?
  takeUpMpm       Float?
  nipRollMpm      Float?
  isuMpm          Float?
  pauMpm          Float?
  stretchingMpm   Float?
  annealingMpm    Float?
  stretchingRatio Float?
  meltPressureP1  Float?
  meltPressureP2  Float?
  meltPressureP3  Float?
  waterBath       Float?
  colour          String?
  denier          Float?
  tapeWidth       Float?
  strength        Float?
  eloPercent      Float?
  spacerWidth     Float?
  numberOfTape    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([date, shiftId])
}

model TapePlantRawMaterial {
  id             String   @id @default(cuid())
  date           String   // YYYY-MM-DD
  shiftId        String
  material       String   // PP, CC, MB, RP1, RP2, HD RP, TPT, etc.
  grade          String?
  openingStock   Float    @default(0)
  received       Float    @default(0)
  total          Float    @default(0)
  consumption    Float    @default(0)
  closingStock   Float    @default(0)
  settingPercent Float?
  actualPercent  Float?
  wastage        Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([date, shiftId])
}

model TapePlantPostProduction {
  id                 String   @id @default(cuid())
  date               String   // YYYY-MM-DD
  shiftId            String
  recipeQuality      String?
  plannedProductionKg Float   @default(0)
  productionDoneKg   Float    @default(0)
  gapKg              Float    @default(0)
  wasteKg            Float    @default(0)
  wastePercent       Float?
  netProductionKg    Float    @default(0)
  entries            Json     @default("[]") // Array of per-recipe outputs: { id, planId, recipeQuality, plannedProductionKg, productionDoneKg, gapKg, wasteKg, wastePercent, netProductionKg, remarks }
  qualityChecks      Json     @default("[]") // Array of { time, colour, denier, width, strength, eloPercent, spacerWidth, remarks }
  status             String   @default("DRAFT") // DRAFT | SUBMITTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id])

  @@unique([date, shiftId])
  @@index([date])
  @@index([shiftId])
}







