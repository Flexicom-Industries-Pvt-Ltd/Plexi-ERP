# Server Variables
# NODE_ENV="development"
# Pooled URL for the app (Neon pooler host, or use direct for local dev)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations (Neon non-pooler host) — required on Vercel build
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# S3 Configuration (Placeholder for now)
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Client Variables
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth
AUTH_SECRET="generate_a_random_base64_string_here"
